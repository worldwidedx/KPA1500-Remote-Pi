[Unit]
Description=KPA1500 Web Remote
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tuckpi
Group=tuckpi
WorkingDirectory=/home/tuckpi/kpa1500-web
ExecStart=/usr/bin/node /home/tuckpi/kpa1500-web/src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/tuckpi/kpa1500-web/data

[Install]
WantedBy=multi-user.target
